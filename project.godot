; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Orchestrateur de Drones - Simulation feu de forêt"
config/description="Simulation 3D d'une flotte de drones (1 surveillance, 2 action) orchestrée par des règles d'automatisation modifiables."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor]

export/convert_text_resources_to_binary=false

[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=3
anti_aliasing/quality/msaa_3d=2
global_illumination/sdfgi/probe_ray_count=2
anti_aliasing/quality/use_taa=true
